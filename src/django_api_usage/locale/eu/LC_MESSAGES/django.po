#: src/django_api_usage/admin.py:48
msgid "Export selected rows to CSV"
msgstr "Esportatu hautatutako errenkadak CSVra"

#: src/django_api_usage/admin.py:131 src/django_api_usage/admin.py:359
msgid "Application"
msgstr "Aplikazioa"

#: src/django_api_usage/admin.py:153 src/django_api_usage/admin.py:295
#: src/django_api_usage/admin.py:367
msgid "Method"
msgstr "Metodoa"

#: src/django_api_usage/admin.py:192 src/django_api_usage/admin.py:299
#: src/django_api_usage/admin.py:363
msgid "Site"
msgstr "Webgunea"

#: src/django_api_usage/admin.py:232 src/django_api_usage/models.py:100
msgid "Client application"
msgstr "Bezero-aplikazioa"

#: src/django_api_usage/admin.py:248
msgid "Not attributed"
msgstr "Esleitu gabea"

#: src/django_api_usage/admin.py:352
msgid ""
"Search by endpoint path, route name, app, method or replacement (for example "
"'herriak' or 'artikuluak')."
msgstr ""
"Bilatu endpointaren bidearen, route-izenaren, aplikazioaren, metodoaren edo "
"ordezkoaren arabera (adibidez 'herriak' edo 'artikuluak')."

#: src/django_api_usage/admin.py:371
msgid "Endpoint"
msgstr "Endpointa"

#: src/django_api_usage/admin.py:427
#, python-brace-format
msgid "Flushed {count} buffered counter(s)."
msgstr "{count} kontagailu eraman dira bufferretik datu-basera."

#: src/django_api_usage/admin.py:434
msgid ""
"Nothing was buffered: with BUFFER_BACKEND='db' counters are already in the "
"database."
msgstr ""
"Ez zegoen ezer bufferrean: BUFFER_BACKEND='db' denean kontagailuak jada datu-"
"basean daude."

#: src/django_api_usage/admin.py:446
#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/change_list.html:12
#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/confirm_clear.html:8
msgid "Clear statistics"
msgstr "Estatistikak hustu"

#: src/django_api_usage/admin.py:458
#, python-brace-format
msgid "Deleted {count} statistic row(s)."
msgstr "{count} estatistika-errenkada ezabatu dira."

#: src/django_api_usage/admin.py:522
msgid "Matching rules"
msgstr "Bat-etortze arauak"

#: src/django_api_usage/admin.py:526
msgid ""
"Checked in this order: account, request host, client network, user agent. "
"Between applications, the lowest priority wins. Accounts are assigned from "
"the 'Client application accounts' table."
msgstr ""
"Ordena honetan egiaztatzen da: kontua, eskaeraren ostalaria, bezeroaren "
"sarea eta user agent-a. Aplikazioen artean, lehentasun txikiena duenak "
"irabazten du. Kontuak 'Bezero-aplikazioko kontuak' taulatik esleitzen dira."

#: src/django_api_usage/admin.py:550
msgid "Accounts"
msgstr "Kontuak"

#: src/django_api_usage/admin.py:554
msgid "Counters"
msgstr "Kontagailuak"

#: src/django_api_usage/admin.py:582 src/django_api_usage/models.py:134
msgid "Account"
msgstr "Kontua"

#: src/django_api_usage/models.py:79
msgid "Short, stable label stored in the counters (e.g. 'mugikorra')."
msgstr ""
"Kontagailuetan gordetzen den etiketa labur eta egonkorra (adib. 'mugikorra')."

#: src/django_api_usage/models.py:85
msgid "Lower wins when several apps could match."
msgstr "Hainbat aplikaziok bat etorri ahalketenean, txikienak irabazten du."

#: src/django_api_usage/models.py:89
msgid "One host per line; matched against the Origin/Referer host."
msgstr ""
"Ostalari bat lerroko; Origin/Referer ostalariaren aurka egiaztatzen da."

#: src/django_api_usage/models.py:92
msgid "One CIDR per line, e.g. 10.0.0.0/8."
msgstr "CIDR bat lerroko, adib. 10.0.0.0/8."

#: src/django_api_usage/models.py:96
msgid "One substring per line, matched case-insensitively."
msgstr ""
"Azpikate bat lerroko; maiuskulak/minuskulak bereizi gabe egiaztatzen da."

#: src/django_api_usage/models.py:101
msgid "Client applications"
msgstr "Bezero-aplikazioak"

#: src/django_api_usage/models.py:135
msgid "One application per account, so the token is unambiguous."
msgstr "Aplikazio bat kontu bakoitzeko, tokena zalantzarik gabea izan dadin."

#: src/django_api_usage/models.py:140
msgid "Client application account"
msgstr "Bezero-aplikazioko kontua"

#: src/django_api_usage/models.py:141
msgid "Client application accounts"
msgstr "Bezero-aplikazioko kontuak"

#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/change_list.html:8
msgid "Flush now"
msgstr "Flush orain"

#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/change_list.html:21
#, python-format
msgid "TOTAL COUNT: %(total)s"
msgstr "GUZTIRA: %(total)s"

#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/confirm_clear.html:6
msgid "Home"
msgstr ""

#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/confirm_clear.html:7
msgid "Endpoint stats"
msgstr "Endpoint estatistikak"

#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/confirm_clear.html:14
#, python-format
msgid ""
"\n"
"      This will delete the only aggregated statistic row. Endpoints and "
"their\n"
"      deprecation metadata are kept.\n"
"    "
msgid_plural ""
"\n"
"      This will delete all %(counter)s aggregated statistic rows. Endpoints\n"
"      and their deprecation metadata are kept.\n"
"    "
msgstr[0] ""
"\n"
"      Estatistika-errenkada agregatu bakarra ezabatuko da. Endpointak eta "
"haien\n"
"      deprecation-metadatuak mantendu egingo dira.\n"
"    "
msgstr[1] ""
"\n"
"      %(counter)s estatistika-errenkada agregatu ezabatuko dira. Endpointak\n"
"      eta haien deprecation-metadatuak mantendu egingo dira.\n"
"    "

#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/confirm_clear.html:24
msgid "Yes, clear statistics"
msgstr "Bai, estatistikak hustu"

#: src/django_api_usage/templates/admin/django_api_usage/endpointstat/confirm_clear.html:25
msgid "Cancel"
msgstr ""

